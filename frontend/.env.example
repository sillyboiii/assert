# Address of the deployed Commitment contract (V1, ETH-only, deployed on Base).
# Copy this to .env and fill in after deployment.
VITE_COMMITMENT_ADDRESS=
# Address of the deployed CommitmentV2 contract (USDC asserts, deployed on Base).
# Leave unset to hide USDC from the app; the USDC toggle only appears once this is set.
VITE_COMMITMENT_V2_ADDRESS=
# USDC contract to use for USDC asserts. Defaults to Circle USDC on Base mainnet:
# 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
VITE_USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
VITE_WALLET_CONNECT_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
